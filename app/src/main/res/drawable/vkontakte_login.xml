<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:id="@id/normal">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#0077FF" />
                    <corners android:radius="60dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="#99000000" />
                    <corners android:radius="60dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:id="@id/pressed">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#0077FF" />
                    <corners android:radius="60dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="#80000000" />
                    <corners android:radius="60dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <transition>

    </transition>
</selector>